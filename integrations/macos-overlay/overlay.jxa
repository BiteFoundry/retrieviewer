var CG_ON_SCREEN_ONLY = 1, CG_ON_SCREEN_ABOVE = 2, CG_INCLUDING_WINDOW = 8, CG_EXCLUDE_DESKTOP = 16;
var STYLE_BORDERLESS = 0, STYLE_TITLED = 1, STYLE_CLOSABLE = 2, STYLE_NONACTIVATING = 128;
var BACKING_BUFFERED = 2, FLOATING_LEVEL = 3, ACTIVATION_ACCESSORY = 1, ANIMATION_NONE = 2;
// canJoinAllSpaces | stationary | ignoresCycle | fullScreenAuxiliary
var OVERLAY_SPACES = 1 | 16 | 64 | 256;
var BAR_WIDTH = 538, BAR_HEIGHT = 40;

var shell = null;

function emit(value) {
  var line = $(JSON.stringify(value) + '\n').dataUsingEncoding($.NSUTF8StringEncoding);
  $.NSFileHandle.fileHandleWithStandardOutput.writeData(line);
}

// CGWindowListCopyWindowInfo returns a +1 CFArray. Older JXA hands it back as
// an opaque Ref that must be cast; it is deep-copied into JS values and released.
function windowInfos(option, relativeTo) {
  var ref = $.CGWindowListCopyWindowInfo(option, relativeTo), list = null;
  if (ref === null || ref === undefined) return [];
  if (typeof Ref === 'function' && ref instanceof Ref) {
    list = ObjC.deepUnwrap(ObjC.castRefToObject(ref));
    if (list) $.CFRelease(ref);
  } else {
    list = ObjC.deepUnwrap(ref);
  }
  return list instanceof Array ? list : [];
}
function windowById(id) {
