// JXA + AppKit/Foundation/CoreGraphics bridge only: no compiler, Python, Swift,
// Electron, downloaded binary, Accessibility API, event tap, injection, screen
// image capture, privacy prompt or agent/terminal content access. Window titles,
// positions and the foreground PID are read as metadata only.
// stdout carries NDJSON protocol messages only; nothing else is ever written there.
// Source is ASCII-only (non-ASCII text is \u-escaped) so osascript decoding cannot vary.
// ES5 syntax only: no arrow functions, let/const, classes or template literals.

// <pure> -- No ObjC below this line until </pure>; evaluated by Node tests.
var MAX_CELLS = 125000, LOW_PROFILE_CELLS = 20000, MAX_LINE_BYTES = 800000;
