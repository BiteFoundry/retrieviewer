    var item = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent($(entry[0]), entry[1], $(''));
    item.target = shell.controller;
    menu.addItem(item);
  });
  statusItem.setMenu(menu);

  function placeBar(canvas) {
    var rect = { x: canvas.x + canvas.width - BAR_WIDTH - 10, y: canvas.y + 10, width: BAR_WIDTH, height: BAR_HEIGHT };
    bar.setFrameDisplay(nsRect(cgToCocoa(rect, primaryHeight())), true);
    if (!bar.isVisible) bar.orderFrontRegardless;
  }
  var core = createCore({
    emit: emit,
    observe: function (target) {
      var info = windowById(target.id), result = { info: info, frontPid: -1, covered: false };
      if (info && info.onscreen && !testMode) {
        result.frontPid = frontPid();
        if (result.frontPid === target.pid) result.covered = coveredBySameApp(windowInfos(CG_ON_SCREEN_ABOVE | CG_EXCLUDE_DESKTOP, target.id), target);
      }
      return result;
    },
    paint: function (parsed, cell, canvas) { paintInto(pet, parsed, cell, canvas); },
    hidePet: function () { if (pet.panel.isVisible) { pet.panel.orderOut(null); pet.view.setImage(null); } },
    showBar: placeBar,
    hideBar: function () { hidePanel(bar); },
    status: function (text) { statusLabel.setStringValue($(text)); },
    loaded: function () { if (testMode) ballButton.performClick(null); },
    quit: function () {
      if (timer) timer.invalidate;
      $.NSNotificationCenter.defaultCenter.removeObserver(shell.controller);
      if (picker) { picker.setDelegate(null); picker.orderOut(null); }
      pet.panel.orderOut(null); bar.orderOut(null);
      if (testTarget) testTarget.orderOut(null);
      if (statusItem) $.NSStatusBar.systemStatusBar.removeStatusItem(statusItem);
      try { emit({ type: 'quit' }); } catch (ignored) {}
      $.exit(0);
    }
  }, { testMode: testMode });
  shell.core = core;

  function refreshPicker() {
    pickerItems = pickerTargets(windowInfos(CG_ON_SCREEN_ONLY | CG_EXCLUDE_DESKTOP, 0), me);
    pickerList.removeAllItems;
    for (var i = 0; i < pickerItems.length; i++) pickerList.addItemWithTitle($(pickerItems[i].title));
  }
  function choose() {
    if (picker || core.state.quitting) return;
    core.setPicking(true); core.track(true);
    picker = makePanel({ x: 0, y: 0, width: 650, height: 230 }, STYLE_TITLED | STYLE_CLOSABLE);
    picker.setTitle($('Retrieviewer - Choose a window'));
    picker.setLevel(FLOATING_LEVEL);
    picker.setDelegate(shell.controller);
    var view = picker.contentView;
    view.addSubview(makeLabel('Choose an app window for Retrieviewer.\n' +
      'Only its position and size are followed. Contents are never read.\n' +
      'Without Screen Recording permission, app names and window IDs replace titles.',
      { x: 18, y: 150, width: 614, height: 64 }, null));
    pickerList = $.NSPopUpButton.alloc.initWithFramePullsDown($.NSMakeRect(18, 106, 600, 28), false);
    view.addSubview(pickerList);
    view.addSubview(makeButton('Refresh', { x: 18, y: 24, width: 100, height: 34 }, 'onRefresh:'));
    view.addSubview(makeButton('Attach', { x: 378, y: 24, width: 140, height: 34 }, 'onAttach:'));
    view.addSubview(makeButton('Cancel', { x: 528, y: 24, width: 90, height: 34 }, 'onCancel:'));
    refreshPicker();
    picker.center;
    app.activateIgnoringOtherApps(true);
    picker.makeKeyAndOrderFront(null);
    emit({ type: 'picker', visible: picker.isVisible });
  }
  function pickerClosed() {
    if (!picker) return;
    picker.setDelegate(null); picker = null; pickerList = null; core.setPicking(false);
    emit({ type: 'picker', visible: false });
    if (core.state.quitting) return;
    if (!core.state.target) statusLabel.setStringValue($(TEXT.chooseFromMenu));
    statusItem.button.setToolTip($(core.state.target ? 'Retrieviewer - Attached' : 'Retrieviewer - Choose window'));
    // Hand focus back: to the window the user just chose, otherwise to whoever had it.
    var chosen = attachedPid ? $.NSRunningApplication.runningApplicationWithProcessIdentifier(attachedPid) : null;
    attachedPid = 0;
    if (chosen && !chosen.isNil()) chosen.activateWithOptions(0); else app.deactivate;
    core.track(true);
  }
  function readMore() { input.readInBackgroundAndNotifyForModes(readModes); }

  shell.onInput = function (note) {
    var data = note.userInfo.objectForKey(dataKey);
    if (!data || data.isNil() || data.length === 0) { core.quit(); return; } // EOF: parent is gone.
    buffer.appendData(data);
    for (;;) {
      var length = buffer.length;
      var found = length ? buffer.rangeOfDataOptionsRange(newline, 0, $.NSMakeRange(0, length)) : null;
      if (!found || found.location >= length) break;
      var line = $.NSString.alloc.initWithDataEncoding(buffer.subdataWithRange($.NSMakeRange(0, found.location)), $.NSUTF8StringEncoding);
      buffer = $.NSMutableData.dataWithData(buffer.subdataWithRange($.NSMakeRange(found.location + 1, length - found.location - 1)));
      if (!line || line.isNil()) throw new Error('Overlay input is not UTF-8');
      var text = ObjC.unwrap(line);
      if (text.length) core.message(JSON.parse(text));
      if (core.state.quitting) return;
    }
    if (buffer.length > MAX_LINE_BYTES) throw new Error('Oversized overlay input line');
    readMore();
  };
  shell.onTick = function () {
    if (!announced) {
      announced = true;
      if (!testMode) choose();
      emit({ type: 'ready', pickerVisible: !!(picker && picker.isVisible) });
    }
    core.track(false);
  };
  shell.onBall = function () { core.interact('ball'); };
  shell.onTreat = function () { core.interact('treat'); };
  shell.onTug = function () { core.interact('tug'); };
  shell.onPick = function () { choose(); };
  shell.onPause = function () { core.togglePause(); };
  shell.onQuit = function () { core.quit(); };
  shell.onRefresh = function () { if (picker) refreshPicker(); };
  shell.onAttach = function () {
    if (!picker) return;
    var index = pickerList.indexOfSelectedItem;
    if (index < 0 || index >= pickerItems.length) return;
    var item = pickerItems[index];
    core.attach({ id: item.id, pid: item.pid, title: item.title });
    attachedPid = item.pid;
    picker.close; // windowWillClose: finishes the hand-off.
  };
  shell.onCancel = function () { if (picker) picker.close; };
  shell.onWindowWillClose = function () { pickerClosed(); };

  if (testMode) {
    // Diagnostics follow only an owned, off-screen window.
    testTarget = makePanel({ x: -12000, y: -12000, width: 1280, height: 800 }, STYLE_BORDERLESS | STYLE_NONACTIVATING);
    testTarget.orderFrontRegardless;
    core.attach({ id: testTarget.windowNumber, pid: me, title: 'owned diagnostic window' });
  }
  $.NSNotificationCenter.defaultCenter.addObserverSelectorNameObject(shell.controller, 'onInput:', readNote, input);
  readMore();
  timer = $.NSTimer.timerWithTimeIntervalTargetSelectorUserInfoRepeats(0.05, shell.controller, 'onTick:', null, true);
  $.NSRunLoop.mainRunLoop.addTimerForMode(timer, $.NSRunLoopCommonModes);
  app.run;
  return 0;
}

// Owned windows only: never clicks, captures, focuses or moves a user application.
function selfTest(proofPath) {
  var app = $.NSApplication.sharedApplication;
  app.setActivationPolicy(ACTIVATION_ACCESSORY);
  function pump() { $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.25)); }
  var frontBefore = frontPid(), result = { type: 'self-test' };
  var target = makePanel({ x: -12000, y: -12000, width: 1600, height: 1000 }, STYLE_BORDERLESS | STYLE_NONACTIVATING);
  var pet = makePetPanel();
  try {
    target.orderFrontRegardless; pump();
    var info = windowById(target.windowNumber), height = primaryHeight();
    result.windowList = !!info;
    var expected = rectFromStruct(target.frame);
    result.geometryConsistent = !!info && sameRect(cgToCocoa(info.bounds, height), expected);
    var frame = { type: 'frame', revision: 1, x: 2, y: 1, columns: 3, rows: 2, text: '\u28FF\u2800\u2847\n\u2800\u28B8\u28FF' };
    var parsed = parseFrame(frame, 12, info ? info.bounds : null);
    var painted = paintInto(pet, parsed, 12, info.bounds);
    result.dots = painted.raster.dots;
    var rep = $.NSBitmapImageRep.imageRepWithData(painted.data);
    result.bitmapDecoded = !!rep && !rep.isNil() && rep.pixelsWide === painted.raster.width && rep.pixelsHigh === painted.raster.height;
    var scale = painted.raster.width / painted.rect.width;
    result.inkAtDot = result.bitmapDecoded && rep.colorAtXY(Math.floor(3 * scale), Math.floor(3 * scale)).alphaComponent > 0.5;
    result.clearBetweenDots = result.bitmapDecoded && rep.colorAtXY(Math.floor(18 * scale), Math.floor(6 * scale)).alphaComponent === 0;
    result.followGeometry = sameRect(cocoaToCg(rectFromStruct(pet.panel.frame), height), petRect(info.bounds, parsed, 12));
    result.clickThrough = pet.panel.ignoresMouseEvents === true;
    result.nonActivating = (pet.panel.styleMask & STYLE_NONACTIVATING) !== 0;
    result.neverKey = pet.panel.canBecomeKeyWindow === false && pet.panel.canBecomeMainWindow === false;
    result.transparent = pet.panel.isOpaque === false && pet.panel.hasShadow === false;
    target.setFrameDisplay($.NSMakeRect(-11000, -11500, 1800, 1100), true); pump();
    var moved = windowById(target.windowNumber);
    paintInto(pet, parsed, 12, moved.bounds);
    result.followsMove = !!moved && sameRect(cocoaToCg(rectFromStruct(pet.panel.frame), height), petRect(moved.bounds, parsed, 12));
    target.orderOut(null); pump();
    var hidden = windowById(target.windowNumber);
    result.hiddenDetected = !hidden || !hidden.onscreen;
    hidePanel(pet.panel);
    result.petHidden = pet.panel.isVisible === false;
    result.foregroundPreserved = frontPid() === frontBefore;
    if (proofPath) result.proofWritten = painted.data.writeToFileAtomically($(proofPath), true) === true;
  } catch (error) {
    result.error = String(error && error.message || error);
  } finally {
    target.orderOut(null); pet.panel.orderOut(null);
  }
  var checks = ['windowList', 'geometryConsistent', 'bitmapDecoded', 'inkAtDot', 'clearBetweenDots', 'followGeometry', 'clickThrough',
    'nonActivating', 'neverKey', 'transparent', 'followsMove', 'hiddenDetected', 'petHidden', 'foregroundPreserved'];
  result.passed = !result.error && result.dots > 0 && checks.every(function (key) { return result[key] === true; }) && (!proofPath || result.proofWritten === true);
  emit(result);
  return result.passed ? 0 : 1;
}

function run(argv) {
  var code = 1;
  try {
    ObjC.import('Cocoa');
    ObjC.import('CoreGraphics');
    ObjC.import('stdlib');
    ObjC.bindFunction('CFRelease', ['void', ['void *']]);
    var args = [];
    for (var i = 0; i < argv.length; i++) args.push(String(argv[i]));
    if (args[0] === '--self-test' && args.length <= 2) code = selfTest(args[1] || null);
    else if (args.length === 0 || (args.length === 1 && args[0] === '--ipc-test')) code = startCompanion(args[0] === '--ipc-test');
    else throw new Error('Unsupported native painter argument');
  } catch (error) {
    try { emit({ type: 'error', message: String(error && error.message || error) }); } catch (ignored) {}
    code = 1;
  }
  // Exit explicitly so osascript never prints a script result onto the protocol stream.
  $.exit(code);
}
