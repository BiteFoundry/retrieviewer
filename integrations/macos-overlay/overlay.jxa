  content.addSubview(makeButton('Tug', { x: 144, y: 6, width: 64, height: 28 }, 'onTug:'));
  content.addSubview(makeButton('Window', { x: 212, y: 6, width: 64, height: 28 }, 'onPick:'));
  content.addSubview(makeButton('Pause', { x: 280, y: 6, width: 64, height: 28 }, 'onPause:'));
  content.addSubview(makeButton('Quit', { x: 348, y: 6, width: 64, height: 28 }, 'onQuit:'));
