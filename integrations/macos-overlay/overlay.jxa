  var input = $.NSFileHandle.fileHandleWithStandardInput, timer = null, picker = null, pickerItems = [], pickerList = null;
  var announced = false, testTarget = null, statusItem = null, ballButton = null, statusLabel = null, attachedPid = 0;
  var readModes = $([$.NSDefaultRunLoopMode, $.NSEventTrackingRunLoopMode, $.NSModalPanelRunLoopMode]);
