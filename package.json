{
  "name": "@bitefoundry/retrieviewer",
  "version": "0.0.11",
  "description": "A fluffy Braille desktop pet for Windows and Linux X11, with experimental macOS support and an embeddable TUI engine.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://bitefoundry.github.io/retrieviewer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BiteFoundry/retrieviewer.git"
  },
  "bugs": {
    "url": "https://github.com/BiteFoundry/retrieviewer/issues"
  },
  "keywords": [
    "tui",
    "braille",
    "pet",
    "retriever",
    "opencode",
    "desktop-pet",
    "windows",
    "linux",
    "macos",
    "overlay"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "private": false,
  "type": "module",
  "types": "./retrieviewer.d.mts",
  "bin": {
    "retrieviewer": "retrieviewer-cli.mjs",
    "retrieviewer-stdio": "retrieviewer-stdio.mjs"
  },
  "exports": {
    ".": {
      "types": "./retrieviewer.d.mts",
      "default": "./retrieviewer.mjs"
    },
    "./plugin": {
      "types": "./retrieviewer-plugin.d.mts",
      "default": "./retrieviewer-plugin.mjs"
    },
    "./tui": "./integrations/opencode/tui.tsx",
    "./opencode/tui": "./integrations/opencode/tui.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
